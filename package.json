{
  "name": "each-answer-interview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/start-local.mjs --no-open",
    "start:local": "node scripts/start-local.mjs",
    "dev:web": "next dev --webpack --hostname 127.0.0.1",
    "dev:realtime": "node --import tsx scripts/run-local-realtime.mjs",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "prepare:context": "node scripts/prepare-context.mjs",
    "prepare:question-references": "tsx scripts/prepare-question-references.ts",
    "analyze:question-references": "tsx scripts/analyze-question-references.ts",
    "prepare:question-strategies": "tsx scripts/prepare-question-strategies.ts",
    "compile:interviewer-policy": "tsx scripts/compile-interviewer-policy.ts",
    "evaluate:interviewer": "tsx scripts/evaluate-interviewer-quality.ts",
    "semantic:identity": "tsx scripts/verify-semantic-release.ts identity",
    "semantic:collect": "tsx scripts/verify-semantic-release.ts collect",
    "semantic:verify": "tsx scripts/verify-semantic-release.ts verify --require-latency",
    "compare:followup-latency": "tsx scripts/compare-followup-latency.ts",
    "prepare:activities": "tsx scripts/prepare-activities.ts",
    "prepare:interview": "tsx scripts/prepare-interview-bank.ts",
    "verify:context": "tsx scripts/verify-interview-context.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components hooks lib server tests scripts --no-error-on-unmatched-pattern",
    "test": "tsx --import ./tests/local-composition.mjs --test --test-concurrency=4 tests/*.test.ts",
    "test:portable": "node scripts/run-portable-tests.mjs",
    "verify:source-closure": "node scripts/verify-source-closure.mjs",
    "verify:contracts": "node scripts/verify-proposed-contracts.mjs",
    "verify:domain-contracts": "tsx scripts/verify-domain-contracts.ts",
    "export:domain-schemas": "tsx scripts/export-domain-schemas.ts",
    "verify:analysis-private": "tsx scripts/verify-analysis-domain-roundtrip.ts",
    "verify:question-private": "tsx scripts/verify-question-domain-roundtrip.ts",
    "capture:source": "node scripts/capture-source-snapshot.mjs",
    "prepare:evaluation-scopes": "node --import tsx scripts/run-local-cli.mjs prepare-evaluation-scopes.ts",
    "build": "next build --webpack",
    "prepare:live2d-sdk": "node scripts/setup-live2d-sdk.mjs",
    "verify:live2d": "node scripts/verify-live2d-assets.mjs --report artifacts/live2d-asset-check.json",
    "service:realtime": "node --import tsx scripts/run-service-realtime.mjs",
    "test:db-isolation": "node scripts/run-pr07b-db-tests.mjs",
    "test:db-local": "node scripts/run-pr07b-local-db.mjs",
    "test:storage": "node scripts/run-pr07c-storage-tests.mjs",
    "test:storage-db": "node scripts/run-pr07c-db-tests.mjs",
    "test:storage-db-local": "node scripts/run-pr07c-local-db.mjs",
    "test:storage-unit": "tsx --test tests/storage/*.unit.test.ts",
    "shadow": "tsx scripts/run-read-shadow.ts",
    "test:shadow-unit": "tsx --test tests/shadow/*.unit.test.ts",
    "test:shadow": "node scripts/run-pr07d-storage-tests.mjs",
    "test:shadow-db": "node scripts/run-pr07d-db-tests.mjs",
    "test:shadow-db-local": "node scripts/run-pr07d-local-db.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "^5.3.1",
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@mediapipe/tasks-vision": "^1.2.0",
    "@ricky0123/vad-web": "^0.0.31",
    "dotenv": "^18.0.9",
    "jose": "6.2.15",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "onnxruntime-web": "^1.31.1",
    "openai": "^7.47.0",
    "pdfjs-dist": "^6.4.299",
    "pg": "8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "ajv": "6.15.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
