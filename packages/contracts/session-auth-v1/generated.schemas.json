{
  "version": "authenticated-session-shared-projection-v1",
  "dialect": "draft-07",
  "authority": "New authenticated session transport/projection only; original TS domain codecs/source QA and raw bytes remain authoritative. Not the proposed five envelopes.",
  "schemas": {
    "command": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "authenticated-session-command-v1"
        },
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,160}$"
        },
        "expectedRevision": {
          "type": "string",
          "pattern": "^\\d+$"
        },
        "writerGeneration": {
          "type": "string",
          "pattern": "^\\d+$"
        },
        "resume": {
          "type": "boolean"
        },
        "payload": {}
      },
      "required": [
        "version",
        "key",
        "expectedRevision",
        "writerGeneration",
        "payload"
      ],
      "additionalProperties": false
    },
    "envelope": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "authenticated-session-envelope-v1"
        },
        "sessionJson": {
          "type": "string",
          "minLength": 2
        },
        "sessionSha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "contextJson": {
          "type": "string",
          "minLength": 2
        },
        "contextSha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "version",
        "sessionJson",
        "sessionSha256",
        "contextJson",
        "contextSha256"
      ],
      "additionalProperties": false
    },
    "runtimeProjection": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "authenticated-session-runtime-v1"
        },
        "owner": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "mode": {
              "type": "string",
              "const": "authenticated"
            }
          },
          "required": [
            "id",
            "mode"
          ],
          "additionalProperties": false
        },
        "engineVersion": {
          "type": "string",
          "minLength": 1
        },
        "contextSnapshotSha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "checkpoint": {
          "type": "object",
          "properties": {
            "phase": {
              "type": "string",
              "minLength": 1
            },
            "at": {
              "type": "string",
              "minLength": 1
            },
            "turnId": {
              "type": [
                "string",
                "null"
              ]
            },
            "answerId": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "phase",
            "at",
            "turnId",
            "answerId"
          ],
          "additionalProperties": {}
        },
        "operations": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "running",
                  "committed",
                  "blocked",
                  "retryable"
                ]
              },
              "startedAt": {
                "type": "string",
                "minLength": 1
              },
              "epoch": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "status",
              "startedAt",
              "epoch"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "version",
        "owner",
        "engineVersion",
        "contextSnapshotSha256",
        "epoch",
        "checkpoint",
        "operations"
      ],
      "additionalProperties": {}
    },
    "sessionProjection": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "createdAt": {
          "type": "string",
          "minLength": 1
        },
        "updatedAt": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "ending",
            "completed"
          ]
        },
        "evaluationStatus": {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "completed",
            "failed",
            "review_required"
          ]
        },
        "runtime": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "const": "authenticated-session-runtime-v1"
            },
            "owner": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "mode": {
                  "type": "string",
                  "const": "authenticated"
                }
              },
              "required": [
                "id",
                "mode"
              ],
              "additionalProperties": false
            },
            "engineVersion": {
              "type": "string",
              "minLength": 1
            },
            "contextSnapshotSha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "epoch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "checkpoint": {
              "type": "object",
              "properties": {
                "phase": {
                  "type": "string",
                  "minLength": 1
                },
                "at": {
                  "type": "string",
                  "minLength": 1
                },
                "turnId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "answerId": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "phase",
                "at",
                "turnId",
                "answerId"
              ],
              "additionalProperties": {}
            },
            "operations": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "running",
                      "committed",
                      "blocked",
                      "retryable"
                    ]
                  },
                  "startedAt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "epoch": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "status",
                  "startedAt",
                  "epoch"
                ],
                "additionalProperties": {}
              }
            }
          },
          "required": [
            "version",
            "owner",
            "engineVersion",
            "contextSnapshotSha256",
            "epoch",
            "checkpoint",
            "operations"
          ],
          "additionalProperties": {}
        },
        "target": {},
        "sourceManifest": {},
        "turns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "questionText": {
                "type": "string"
              },
              "questionKind": {
                "type": "string",
                "enum": [
                  "main",
                  "follow_up",
                  "clarification"
                ]
              },
              "parentMainQuestionId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "mainIndex": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "mainCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "followUpIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "questionAudioUrl": {
                "type": "string"
              },
              "acknowledgement": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "acknowledgementAudioUrl": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "interviewerId": {
                "type": "string"
              },
              "metadata": {
                "type": "object",
                "properties": {
                  "rulesVersion": {
                    "type": "string"
                  },
                  "generatedAt": {
                    "type": "string"
                  }
                },
                "required": [
                  "rulesVersion",
                  "generatedAt"
                ],
                "additionalProperties": {}
              },
              "answerId": {
                "type": "string"
              },
              "rawTranscript": {
                "type": "string"
              },
              "transcriptStatus": {
                "type": "string",
                "enum": [
                  "streaming",
                  "paused",
                  "finalized",
                  "error"
                ]
              }
            },
            "required": [
              "id",
              "questionText",
              "questionKind",
              "parentMainQuestionId",
              "mainIndex",
              "mainCount",
              "followUpIndex",
              "evidenceIds",
              "questionAudioUrl",
              "acknowledgement",
              "acknowledgementAudioUrl",
              "interviewerId",
              "metadata"
            ],
            "additionalProperties": {}
          }
        },
        "followUpCountByMainQuestion": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "elapsedMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "createdAt",
        "updatedAt",
        "status",
        "evaluationStatus",
        "runtime",
        "target",
        "sourceManifest",
        "turns",
        "followUpCountByMainQuestion",
        "elapsedMs"
      ],
      "additionalProperties": {}
    }
  }
}
