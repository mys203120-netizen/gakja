// Isolated PostgreSQL schema; never mutates a real account or frozen report.
import assert from 'node:assert/strict';
import {randomUUID,createHash} from 'node:crypto';
import {readFileSync,readdirSync} from 'node:fs';
import {join} from 'node:path';
import {registerHooks} from 'node:module';
import {pathToFileURL} from 'node:url';
import pg from 'pg';
import {loadProjectEnv,projectRoot} from '../scripts/load-env.mjs';
import {buildSpeechTelemetry} from '../apps/web/src/lib/speech-telemetry';
loadProjectEnv();
const originalUrl=process.env.DATABASE_URL!;
if(process.env.AUTH_MODE!=='local'||!['localhost','127.0.0.1'].includes(new URL(originalUrl).hostname))throw new Error('Local isolated PostgreSQL only.');
const schema='qa_speech_'+randomUUID().replaceAll('-','');
assert.match(schema,/^qa_speech_[a-f0-9]{32}$/);
const admin=new pg.Client({connectionString:originalUrl});await admin.connect();
const connection=new URL(originalUrl);connection.searchParams.set('options',`-c search_path=${schema},public`);process.env.DATABASE_URL=connection.toString();
registerHooks({resolve(specifier,context,nextResolve){
  if(specifier==='server-only')return {url:pathToFileURL(join(projectRoot,'node_modules/next/dist/compiled/server-only/empty.js')).href,shortCircuit:true};
  if(specifier.startsWith('@/'))return {url:pathToFileURL(join(projectRoot,'apps/web/src',specifier.slice(2)+(specifier.endsWith('.json')?'':'.ts'))).href,shortCircuit:true};
  return nextResolve(specifier,context);
}});
const {pool}=await import('../apps/web/src/lib/db.ts');
const {closeRecordingTranscriptionLocks}=await import('../apps/web/src/lib/recording-transcription.ts');
const {getGrowthPayload,analyzeOwnedRecording,transcribeOwnedQuizRecording}=await import('../apps/web/src/lib/speech-growth-store.ts');
await admin.query(`create schema ${schema}`);
const db=await pool.connect();let checks=0;
const check=(value:unknown,message:string)=>{assert.ok(value,message);checks++;};
const id=randomUUID(),other=randomUUID(),session1=randomUUID(),session2=randomUUID(),turn1=randomUUID(),turn2=randomUUID(),media1=randomUUID(),media2=randomUUID(),foreignSession=randomUUID(),foreignRecording=randomUUID(),reportId=randomUUID(),studyId=randomUUID(),quizId=randomUUID(),quizRecording=randomUUID();
const user={id,email:'qa-speech@gakja.test',name:'합성 발화 검증',role:'student',active:true} as any;
const pack='qa-speech-pack',job='qa-speech-job',question='qa-speech-question';
const learning={activities:[],questions:[{id:question,prompt:'활동에서 무엇을 했나요?',answer_elements:['본인 역할'],activity_ids:[],support_target_ids:[]}],answer_designs:[],source_refs:[],answer_scripts:[],memory_items:[],support_targets:[],student_context:{core_keywords:[],representative_activity_ids:[],confirmed_goals:[]}};
const telemetry=buildSpeechTelemetry(Array.from({length:100},(_,index)=>({atMs:index*100,rms:index>=10&&index<30||index>=50&&index<90?.08:.002})),10_000)!;
try {
  for(const file of readdirSync(join(projectRoot,'supabase/migrations')).filter(name=>name.endsWith('.sql')&&name<='202610120014_speech_growth.sql').sort())await db.query(readFileSync(join(projectRoot,'supabase/migrations',file),'utf8'));
  await db.query("insert into profiles(id,email,name,role) values($1,'qa-speech@gakja.test','합성 검증','student'),($2,'qa-speech-other@gakja.test','다른 합성 검증','student')",[id,other]);
  await db.query('insert into production_links(id,student_id) values($1,$2)',[job,id]);
  await db.query('insert into content_packages(id,student_id,active_version) values($1,$2,1)',[pack,id]);
  await db.query("insert into content_versions(package_id,version,data,learning_hash,status,production_job_ref,published_at) values($1,1,$2,'qa','published',$3,'2026-01-01')",[pack,JSON.stringify(learning),job]);
  const answer=(await db.query("insert into user_answers(student_id,question_id,script) values($1,$2,'내 최신 작성본') returning id",[id,question])).rows[0];
  await db.query("insert into answer_revisions(answer_id,revision,structure,script,data,created_at) values($1,1,'','활동에 참여했습니다.',$2,'2026-01-01'),($1,2,'','제가 시료 준비를 맡았습니다. 조건을 3회 반복했습니다.',$2,'2026-01-02')",[answer.id,JSON.stringify({contentVersion:1,question:learning.questions[0]})]);
  await db.query("insert into interview_sessions(id,student_id,kind,content_version,state) values($1,$3,'video',1,'completed'),($2,$3,'video',1,'completed'),($4,$5,'video',1,'completed')",[session1,session2,id,foreignSession,other]);
  await db.query("insert into interview_turns(id,session_id,student_id,question_id,data,created_at) values($1,$2,$3,$4,$5,'2026-01-02T12:00:00Z'),($6,$7,$3,$4,$8,'2026-01-04')",[turn1,session1,id,question,JSON.stringify({question:learning.questions[0].prompt,answer:'제가 시료를 준비했습니다. 결과를 비교했습니다.',originalAnswer:'제가 시료를 준비했습니다. 결과를 비교했습니다.',rawTranscript:'음 저는 조건을 비교했습니다. 음 결과를 비교했습니다.',transcript:'저는 조건을 비교했습니다.',answeredAt:'2026-01-02T12:00:00Z'}),turn2,session2,JSON.stringify({question:learning.questions[0].prompt,answer:'저는 시료 준비를 맡았습니다. 조건을 3회 반복했습니다. 결과에서 오차를 확인했습니다.',originalAnswer:'저는 시료 준비를 맡았습니다. 조건을 3회 반복했습니다. 결과에서 오차를 확인했습니다.',answeredAt:'2026-01-04T00:00:00Z'})]);
  for(const [recording,session,turn,text,time] of [[media1,session1,turn1,'음 저는 조건을 비교했습니다. 음 결과를 비교했습니다.','2026-01-02T12:00:00Z'],[media2,session2,turn2,'어 저는 시료 준비를 맡았습니다. 조건을 비교했습니다. 결과의 오차를 확인했습니다.','2026-01-04']])await db.query('insert into media_assets(id,student_id,session_id,data,mime,text,metadata,created_at) values($1,$2,$3,$4,$5,$6,$7,$8)',[recording,id,session,Buffer.from('synthetic-private-audio'),'audio/wav',text,JSON.stringify({kind:'answer_recording',questionId:question,turnId:turn,durationSeconds:10,speechTelemetry:telemetry,provider:'postgresql',digest:recording}),time]);
  await db.query('insert into media_assets(id,student_id,session_id,data,mime,text,metadata) values($1,$2,$3,$4,$5,$6,$7)',[foreignRecording,other,foreignSession,Buffer.from('foreign'),'audio/wav','다른 학생 비공개 원전사',JSON.stringify({kind:'answer_recording',questionId:question,durationSeconds:10,speechTelemetry:telemetry})]);
  const frozen={kind:'video',sections:[{questionId:question,question:learning.questions[0].prompt,answer:'저장 당시 답변'}],immutable:'frozen-report'};
  await db.query('insert into interview_reports(id,student_id,session_id,data,created_at) values($1,$2,$3,$4,$5)',[reportId,id,session1,JSON.stringify(frozen),'2026-01-03']);
  await db.query("insert into study_sessions(id,student_id,state,report,finish_reason,ended_at) values($1,$2,'finalized',$3,'manual','2026-01-03')",[studyId,id,JSON.stringify({immutable:'frozen-study',events:[]})]);
  await db.query("insert into study_session_events(session_id,student_id,kind,source_id,data,created_at) values($1,$2,'interview_answer',$3,$4,'2026-01-02T12:00:00Z')",[studyId,id,turn1,JSON.stringify({questionId:question,answer:'저장 당시 답변'})]);
  const overview=await getGrowthPayload(user);
  check(overview.speech.recordings.length===2,'only own recordings returned');
  check(overview.speech.trend?.questionId===question,'same question creates before and after acoustic trend');
  check(overview.speech.recordings.find(row=>row.id===media1)?.analysis.transcript?.fillerCount===2,'raw recognizer text is used instead of cleaned correction');
  check(overview.content.comparisons[0].after.script.includes('오차'),'actual latest answer drives content comparison');
  check(overview.content.comparisons[0].elements.some(element=>element.key==='role'&&element.afterEvidence.some(evidence=>evidence.includes('맡았습니다'))),'quoted role evidence exposed');
  const historical=await getGrowthPayload(user,{reportId});
  check(historical.speech.recordings.length===1&&historical.speech.recordings[0].id===media1,'historical report hides later recordings');
  check(!historical.content.comparisons.some(comparison=>comparison.after.script.includes('오차')),'historical report never imports later answer development');
  const study=await getGrowthPayload(user,{studySessionId:studyId});
  check(study.speech.recordings.length===1,'study end time bounds its acoustic history');
  const empty=await getGrowthPayload({...user,id:other});
  check(empty.content.comparisons.length===0,'other student cannot see answer history');
  await assert.rejects(()=>getGrowthPayload({...user,id:other},{reportId}),error=>(error as any).status===404);checks++;
  await assert.rejects(()=>getGrowthPayload({...user,role:'admin'}),error=>(error as any).status===403);checks++;
  await assert.rejects(()=>analyzeOwnedRecording(user,{recordingId:foreignRecording,kind:'interview'}),error=>(error as any).status===404);checks++;
  await analyzeOwnedRecording(user,{recordingId:media1,kind:'interview'});await analyzeOwnedRecording(user,{recordingId:media1,kind:'interview'});
  check((await db.query('select count(*)::int as n from speech_analysis_versions')).rows[0].n===1,'identical source reanalysis is idempotent and append only');
  await assert.rejects(()=>analyzeOwnedRecording(user,{recordingId:media1,kind:'interview',speechTelemetry:{...telemetry,durationMs:20_000,coverage:{...telemetry.coverage,maxGapMs:10_000}}}),error=>(error as any).status===400);checks++;
  check((await db.query('select data from interview_reports where id=$1',[reportId])).rows[0].data.immutable==='frozen-report','original interview report stays frozen');
  check((await db.query('select report from study_sessions where id=$1',[studyId])).rows[0].report.immutable==='frozen-study','original study report stays frozen');
  await db.query("insert into quiz_sessions(id,student_id,mode,content_version,items,state) values($1,$2,'oral',1,$3,'completed')",[quizId,id,JSON.stringify([{id:'qa-memory',question_id:question,prompt:learning.questions[0].prompt}])]);
  await db.query('insert into quiz_recordings(id,session_id,student_id,item_index,data,mime,duration_ms,metadata) values($1,$2,$3,0,$4,$5,10000,$6)',[quizRecording,quizId,id,Buffer.from('synthetic-quiz'),'audio/wav',JSON.stringify({speechTelemetry:telemetry,transcript:'음 음 제가 조건을 비교했습니다.',transcription:{provider:'mock-stt'},displayTranscript:'음 음 제가 조건을 비교했습니다.',transcriptCleanup:{status:'completed',modelId:'gpt-6-luna',promptVersion:'gakja-transcript-verbatim-2',rawHash:createHash('sha256').update('음 음 제가 조건을 비교했습니다.').digest('hex'),latencyMs:0},provider:'postgresql'})]);
  const quizOverview=await getGrowthPayload(user);
  check(quizOverview.speech.recordings.some(row=>row.kind==='quiz'&&row.analysis.transcript?.fillerCount===2),'quiz raw STT connects to the same speaking report');
  await analyzeOwnedRecording(user,{recordingId:quizRecording,kind:'quiz'});
  check((await db.query("select count(*)::int as n from speech_analysis_versions where recording_kind='quiz'")).rows[0].n===1,'quiz analysis revision persisted');
  const cached=await transcribeOwnedQuizRecording(user,quizRecording);
  check(cached.cached===true&&cached.transcript==='음 음 제가 조건을 비교했습니다.'&&cached.rawTranscript?.startsWith('음 음'),'stored formatted display and raw STT reused without a new provider call');
  await assert.rejects(()=>transcribeOwnedQuizRecording({...user,id:other},quizRecording),error=>(error as any).status===404);checks++;
  const article=randomUUID(),thought=randomUUID(),briefing=randomUUID(),newsSession=randomUUID(),newsTurn=randomUUID(),newsReport=randomUUID();
  await db.query("insert into department_news_articles(id,canonical_url,title,publisher,published_at,feed_key) values($1,'https://speech-test.example.test/article','합성 환경 기사','합성 검증','2026-01-01','test')",[article]);
  await db.query("insert into department_news_thoughts(id,student_id,article_id,content,revision) values($1,$2,$3,'최신 생각',2)",[thought,id,article]);
  await db.query("insert into department_news_thought_revisions(thought_id,student_id,content,revision,created_at) values($1,$2,'기사를 읽고 오염이 중요하다고 생각했습니다.',1,'2026-01-02'),($1,$2,'미래에 수정한 생각은 이때 보이지 않습니다.',2,'2026-01-05')",[thought,id]);
  await db.query("insert into briefings(id,title,category,data,status,created_by) values($1,'합성 환경 기사','환경',$2,'published',$3)",[briefing,JSON.stringify({owner_student_id:id,source_kind:'rss_news',article_id:article,thought_snapshot:{content:'면접 시작 당시 생각',updated_at:'2026-01-03'}}),id]);
  await db.query("insert into interview_sessions(id,student_id,kind,content_version,state,data,created_at) values($1,$2,'chat',1,'completed',$3,'2026-01-04')",[newsSession,id,JSON.stringify({briefingId:briefing,context:{briefingId:briefing,briefing:{article_id:article,thought_snapshot:{content:'면접 시작 당시 생각',updated_at:'2026-01-03'}}}})]);
  await db.query('insert into interview_turns(id,session_id,student_id,question_id,data,created_at) values($1,$2,$3,$4,$5,$6)',[newsTurn,newsSession,id,'briefing_'+briefing+'_0',JSON.stringify({rootQuestionId:'briefing_'+briefing+'_0',question:'이 기사에 대해 말해 주세요.',originalAnswer:'저는 기사의 측정 결과를 비교했습니다. 오차라는 한계를 확인했습니다.',answer:'오류를 다듬은 답변',answeredAt:'2026-01-04T00:00:00Z'}),'2026-01-04']);
  await db.query('insert into interview_reports(id,student_id,session_id,data,created_at) values($1,$2,$3,$4,$5)',[newsReport,id,newsSession,JSON.stringify({sections:[{questionId:'briefing_'+briefing+'_0'}]}),'2026-01-04T12:00:00Z']);
  const news=await getGrowthPayload(user);
  check(news.content.newsComparisons.length===1,'article reflection joins its own root interview answer');
  check(news.content.newsComparisons[0].before.script==='기사를 읽고 오염이 중요하다고 생각했습니다.','earlier thought revision preserved instead of a later rewrite');
  check(news.content.newsComparisons[0].after.script.includes('오차라는 한계'),'original spoken answer preserved instead of corrected transcript');
  check(news.content.newsComparisons[0].sourceHref.endsWith(article)&&news.content.newsComparisons[0].retryHref.includes(briefing),'article and interview links retain shared source identity');
  check((await getGrowthPayload({...user,id:other})).content.newsComparisons.length===0,'another student cannot see thought-to-interview comparison');
  check((await getGrowthPayload(user,{reportId})).content.newsComparisons.length===0,'earlier frozen report never includes a later news flow');
  check((await getGrowthPayload(user,{reportId:newsReport})).content.newsComparisons[0].before.script==='기사를 읽고 오염이 중요하다고 생각했습니다.','news report includes only reflection versions available at its cutoff');
  console.log(`Speech growth PostgreSQL: ${checks} checks passed; external provider calls: 0.`);
}finally{db.release();await closeRecordingTranscriptionLocks();await pool.end();await admin.query(`drop schema ${schema} cascade`);await admin.end();}
