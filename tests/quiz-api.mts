    await db.query('delete from profiles where id=any($1::uuid[]) and email like $2',[[studentId,otherId],`%quiz-${fixture}@gakja.test`]);await db.query('commit');
  }catch(error){await db.query('rollback');throw error;}finally{await db.end();}
