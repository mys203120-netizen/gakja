import {registerReviewedSchool} from './school-registration-fixture.mts';
import assert from 'node:assert/strict';
import {randomUUID,createHash} from 'node:crypto';
import {readFileSync,writeFileSync} from 'node:fs';
import {join} from 'node:path';
import pg from 'pg';
import {loadProjectEnv,projectRoot} from '../scripts/load-env.mjs';
loadProjectEnv();
const base=process.env.SMOKE_BASE_URL || JSON.parse(readFileSync(join(projectRoot,'.local/server.json'),'utf8')).url;
if(process.env.AUTH_MODE!=='local' || !['localhost','127.0.0.1'].includes(new URL(base).hostname) || !['localhost','127.0.0.1'].includes(new URL(process.env.DATABASE_URL!).hostname))throw Error('Local synthetic fixtures only');
const db=new pg.Client({connectionString:process.env.DATABASE_URL});
const students=[randomUUID(),randomUUID()],tokens=[randomUUID(),randomUUID()];let checks=0;
function check(value:unknown,label:string){assert.ok(value,label);checks++;}
async function request(actor:number,path:string,body?:unknown){const response=await fetch(base+path,{method:body?'POST':'GET',headers:{Origin:base,Cookie:'gakja_session='+tokens[actor],...(body?{'Content-Type':'application/json'}:{})},body:body?JSON.stringify(body):undefined});return {status:response.status,body:await response.json()};}
await db.connect();
try{
  for(let i=0;i<students.length;i++){
    await db.query("insert into profiles(id,email,name,role) values($1,$2,'학교 축 합성 검증','student')",[students[i],`school-quiz-${students[i]}@gakja.test`]);
    await db.query("insert into sessions(id,user_id,expires_at) values($1,$2,now()+interval '1 hour')",[createHash('sha256').update(tokens[i]).digest('hex'),students[i]]);
  }
  const catalogue=(await request(0,'/api/schools')).body.catalog;
  const school=catalogue.find((item:any)=>item.canonicalName==='서울시립대학교');
  const departments=(await request(0,'/api/schools/catalog?schoolId='+school.id)).body.school.departments;
  const environment=departments.find((item:any)=>item.name==='환경공학부'),other=departments.find((item:any)=>item.name!==environment.name);
  const first=(await registerReviewedSchool((path,body)=>request(0,path,body),{referenceId:school.id,departmentId:environment.id,admissionYear:2027,track:'합성 면접 검증'})).body.target;
  const second=(await registerReviewedSchool((path,body)=>request(0,path,body),{referenceId:school.id,departmentId:other.id,admissionYear:2027,track:'합성 면접 검증'})).body.target;
  check(first.majorContext.department===environment.name,'registration resolves actual catalogue department');
  const firstPool=await request(0,`/api/quiz?targetId=${first.id}&mode=answer`);
  check(firstPool.status===200,'no-package student can read school quiz');check(firstPool.body.library.choice.length===0,'no unreviewed choice distractors invented');
  const ethics=firstPool.body.library.answer.find((item:any)=>item.talent_profile?.point.id==='ethics');
  check(ethics&&ethics.hasHint===false,'school values have no fabricated private model answer');
  check(firstPool.body.target.department===environment.name,'selected department returned');
  const requested=await request(0,`/api/quiz?targetId=${first.id}&questionId=${ethics.question_id}&mode=answer`);
  check(requested.body.requested?.available&&requested.body.requested.item.id===ethics.id,'exact common question opens its school quiz item');
  check((await request(1,`/api/quiz?targetId=${first.id}`)).status===404,'foreign target cannot read pool');
  check((await request(1,'/api/quiz',{action:'create',mode:'answer',targetId:first.id,itemIds:[ethics.id]})).status===404,'foreign target cannot create');
  const create=await request(0,'/api/quiz',{action:'create',mode:'answer',targetId:first.id,itemIds:[ethics.id],source_snapshot:{title:'forged'}});
  check(create.status===200,'no package common quiz creates');const session=create.body.session;
  check(session.content_version===0&&session.metadata.targetSnapshot.department===environment.name,'session fixes department without package version');
  check(session.items[0].common_revision===1&&session.items[0].source_snapshot.officialPastQuestion===false,'source revision and practice basis fixed');
  check(!JSON.stringify(session).includes('forged'),'client cannot inject a source');
  const duplicate=await request(0,'/api/quiz',{action:'create',mode:'answer',targetId:first.id,itemIds:[ethics.id]});check(duplicate.body.session.id===session.id,'same untouched target selection reuses ready session');
  const secondPool=(await request(0,`/api/quiz?targetId=${second.id}&mode=answer`)).body;
  check(!secondPool.library.answer.some((item:any)=>item.talent_profile?.scope==='department'),'another department cannot receive environment talent');
  check((await request(0,'/api/quiz',{action:'create',mode:'answer',targetId:second.id,itemIds:[ethics.id]})).status===400,'item cannot move to another target');
  const commonId=firstPool.body.library.answer.find((item:any)=>item.question_id==='common_motivation').id;
  check(commonId!==secondPool.library.answer.find((item:any)=>item.question_id==='common_motivation').id,'same common prompt has department-specific recall identity');
  check((await request(0,'/api/quiz',{action:'start',sessionId:session.id})).status===200,'common school quiz starts');
  check((await request(0,'/api/quiz',{action:'hint',sessionId:session.id,itemIndex:0})).status===404,'private answer hint not inferred');
  const answer=await request(0,'/api/quiz',{action:'answer',sessionId:session.id,itemIndex:0,response:'[합성 검증] 직접 겪은 경험은 없지만 타인에게 미칠 영향을 확인하고 책임 있게 실천하겠습니다.',rating:'good'});
  check(answer.status===200&&answer.body.response?.outcome!==true,'school value answer not graded as admission mastery');
  const response=answer.body.response;
  check(response.outcome===null&&response.data.target_id===first.id&&response.data.common_revision===1,'response keeps self-check and school snapshot');
  const [memory]=(await db.query('select * from memory_attempts where student_id=$1 and memory_item_id=$2',[students[0],ethics.id])).rows;
  check(memory.data.correct===null&&memory.data.target_snapshot.department===environment.name&&memory.data.question_id===ethics.question_id,'recall history keeps exact school and common question');
  const [event]=(await db.query("select data from study_session_events where student_id=$1 and kind='quiz_response'",[students[0]])).rows;
  check(event.data.target_id===first.id&&event.data.source_snapshot.url===response.data.source_snapshot.url&&event.data.verified===false,'study/report event links same source without verified mastery');
  const packId='school-quiz-fixture-'+randomUUID();
  const activity={id:'fixture-club',title:'실험 역할 조율',area:'동아리',fact_confirmation:'confirmed_from_record',source_ref_ids:['fixture-record']};
  const privateQuestion={id:'fixture-personal-question',prompt:'실험에서 맡은 실제 역할은 무엇인가요?',activity_ids:[activity.id],source_ref_ids:['fixture-record'],support_target_ids:[first.id],question_types:['activity'],answer_elements:['실제 역할','배운 점'],verification_status:'approved'};
  const privateItem={id:'fixture-personal-memory',kind:'short_speech',question_id:privateQuestion.id,answer_script_id:null,activity_ids:[activity.id],prompt:privateQuestion.prompt,memory_keywords:[],default_time_limit_seconds:60,evaluation_method:'self_check',category:'experiential',source_ref_ids:['fixture-record'],verification_status:'approved'};
  const learning={activities:[activity,{...activity,id:'fixture-disputed',fact_confirmation:'needs_confirmation'}],questions:[privateQuestion],memory_items:[privateItem],answer_scripts:[],answer_designs:[],support_targets:[],student_context:{},source_refs:[{id:'fixture-record',type:'student_record',revision:1,quote:'실험 진행 중 역할을 나눠 조율함',area:'동아리'}]};
  await db.query("insert into production_links(id,student_id,data) values($1,$2,'{\"synthetic\":true}')",[packId,students[0]]);
  await db.query('insert into content_packages(id,student_id,active_version) values($1,$2,1)',[packId,students[0]]);
  await db.query("insert into content_versions(package_id,version,data,learning_hash,status,production_job_ref) values($1,1,$2,$3,'published',$1)",[packId,JSON.stringify(learning),createHash('sha256').update(JSON.stringify(learning)).digest('hex')]);
  check((await request(0,`/api/quiz?targetId=${first.id}&activityId=foreign-activity&mode=answer`)).status===404,'foreign activity excluded');
  check((await request(0,'/api/quiz',{action:'create',mode:'answer',targetId:first.id,activityId:'fixture-disputed',itemIds:[ethics.id]})).status===404,'disputed activity cannot join talent practice');
  const selectedPool=await request(0,`/api/quiz?targetId=${first.id}&activityId=${activity.id}&questionId=${ethics.question_id}&mode=answer`);
  check(selectedPool.body.requested.item.activity_ids[0]===activity.id,'explicit approved activity joins the value question');
  const withoutActivity=await request(0,'/api/quiz',{action:'create',mode:'answer',targetId:first.id,itemIds:[ethics.id]});
  const withActivity=await request(0,'/api/quiz',{action:'create',mode:'answer',targetId:first.id,activityId:activity.id,itemIds:[ethics.id]});
  check(withActivity.status===200&&withActivity.body.session.id!==withoutActivity.body.session.id,'different chosen activity never reuses a blank activity draft');
  const [stored]=(await db.query('select items from quiz_sessions where id=$1',[withActivity.body.session.id])).rows;
  check(stored.items[0].activity_ids[0]===activity.id&&stored.items[0].sourceQuotes.some((source:any)=>source.id==='fixture-record'),'private record and official value sources pinned together');
  check(stored.items[0].modelAnswer===''&&stored.items[0].evaluation_method==='self_check','real experience link still has no fabricated answer key');
  const privateCreate=await request(0,'/api/quiz',{action:'create',mode:'answer',targetId:first.id,itemIds:[privateItem.id]});
  check(privateCreate.status===200,'personal activity quiz still creates normally');const privateSessionId=privateCreate.body.session.id;
  await request(0,'/api/quiz',{action:'start',sessionId:privateSessionId});
  const privateAnswer=await request(0,'/api/quiz',{action:'answer',sessionId:privateSessionId,itemIndex:0,response:'[합성 검증] 실험 역할을 나누어 조율했습니다.',rating:'again',recallStatus:'uncertain'});
  check(privateAnswer.body.response.data.target_id===first.id&&privateAnswer.body.response.data.target_snapshot.department===environment.name,'personal answers keep the same selected school context as interviews');
  const [privateEvent]=(await db.query('select data from study_session_events where student_id=$1 and source_id=$2',[students[0],privateAnswer.body.response.id])).rows;
  check(privateEvent.data.rating==='again'&&privateEvent.data.recall_state==='uncertain'&&privateEvent.data.outcome===null&&privateEvent.data.verified===false,'explicit uncertain recall is recorded for review without a fabricated wrong grade');
  const central=catalogue.find((item:any)=>item.canonicalName==='중앙대학교');
  const centralTarget=(await registerReviewedSchool((path,body)=>request(0,path,body),{referenceId:central.id,admissionYear:2027,campus:'본교',track:'합성 면접 검증',major:'합성학과'})).body.target;
  const currentCentral=(await request(0,`/api/quiz?targetId=${centralTarget.id}&mode=answer`)).body.library.answer.find((item:any)=>item.talent_profile?.university==='중앙대학교');
  const oldCentral=await request(0,`/api/quiz?targetId=${centralTarget.id}&mode=answer&questionId=${currentCentral.question_id}&sourceType=common&sourceVersion=1`);
  check(oldCentral.body.requested.item.common_revision===1&&oldCentral.body.requested.item.source_snapshot.profileRevision===1,'explicit common version pins the historical official source');
  const oldCreate=await request(0,'/api/quiz',{action:'create',mode:'answer',targetId:centralTarget.id,itemIds:[oldCentral.body.requested.item.id],sourceType:'common',sourceVersion:1});
  check(oldCreate.status===200&&oldCreate.body.session.items[0].common_revision===1,'create retains the selected historical common revision');
  const personalVersion=await request(0,`/api/quiz?targetId=${centralTarget.id}&mode=answer&questionId=${currentCentral.question_id}&sourceType=personal&sourceVersion=1`);
  check(personalVersion.body.requested.item.common_revision===2,'personal package version is never interpreted as a common question revision');
  await db.query('update support_targets set data=data || $3::jsonb where id=$1 and student_id=$2',[first.id,students[0],JSON.stringify({major:other.name,department:other.name,department_catalog_id:other.id})]);
  const old=await request(0,'/api/quiz?sessionId='+session.id);
  check(old.status===200&&old.body.session.items[0].target_snapshot.department===environment.name,'old session source remains original after target change');
  check((await request(1,'/api/quiz?sessionId='+session.id)).status===404,'foreign historic session denied');
  const remap=await request(0,`/api/quiz?targetId=${first.id}&memoryItemId=${ethics.id}`);check(remap.body.requested?.available===false,'old department item is not silently remapped');
  const paid=Number((await db.query('select count(*)::int as n from ai_usage_logs where student_id=any($1::uuid[])',[students])).rows[0].n);check(paid===0,'no paid AI calls');
  const result={checks,paidAiCalls:paid,syntheticStudents:2,cleanup:'owned fixtures only',school:school.canonicalName,departments:[environment.name,other.name]};
  writeFileSync(join(projectRoot,'.local/school-quiz-api-check.json'),JSON.stringify(result,null,2));console.log(JSON.stringify(result));
}finally{
  await db.query('begin');
  for(const table of ['study_sessions','quiz_sessions','interview_reports','media_assets','interview_sessions','ai_usage_logs','student_preferences','sessions','audit_logs','school_profiles','support_targets']){
    if(table==='sessions')await db.query('delete from sessions where user_id=any($1::uuid[])',[students]);
    else if(table==='audit_logs')await db.query('delete from audit_logs where actor_id=any($1::uuid[]) or student_id=any($1::uuid[])',[students]);
    else await db.query(`delete from ${table} where student_id=any($1::uuid[])`,[students]);
  }
  await db.query('delete from memory_attempts where student_id=any($1::uuid[])',[students]);
  await db.query('delete from documents where package_id in(select id from content_packages where student_id=any($1::uuid[]))',[students]);
  await db.query('delete from content_versions where package_id in(select id from content_packages where student_id=any($1::uuid[]))',[students]);
  await db.query('delete from content_packages where student_id=any($1::uuid[])',[students]);
  await db.query('delete from production_links where student_id=any($1::uuid[])',[students]);
  await db.query('delete from profiles where id=any($1::uuid[])',[students]);await db.query('commit');await db.end();
}
