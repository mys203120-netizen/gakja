OPENAI_API_KEY=
OPENAI_QUESTION_MODEL=gpt-6-luna
# Independently selected core; changing this preserves the approved Q0 bank.
OPENAI_REALTIME_MODEL=gpt-6.1-terra
OPENAI_REVIEW_MODEL=gpt-6-luna
OPENAI_ANALYSIS_MODEL=gpt-6.1-terra
CLOVA_SPEECH_SECRET_KEY=
CLOVA_SPEECH_DOMAIN_ID=
CLOVA_SPEECH_GRPC_HOST=clovaspeech-gw.ncloud.com
CLOVA_SPEECH_GRPC_PORT=50051
CLOVA_VOICE_CLIENT_ID=
CLOVA_VOICE_CLIENT_SECRET=
CLOVA_VOICE_SPEAKER=vdaeseong
CLOVA_VOICE_SECOND_SPEAKER=vmikyung
CLOVA_VOICE_SPEED=0
# Per-interviewer speed overrides (negative values are faster).
CLOVA_VOICE_PRIMARY_SPEED=0
CLOVA_VOICE_SECOND_SPEED=-1
CLOVA_VOICE_PITCH=1
WEB_PORT=3000
REALTIME_PORT=3001


# API execution is fail-closed service mode when unset.
# Only the local launchers opt in to local-development; production rejects it.
# Setting a local owner ID never enables service authentication or mapping.
INTERVIEW_EXECUTION_MODE=

# Trusted JWT verification configuration; empty means unavailable.
# A server-managed operational account/resource resolver is also required.
# No resolver or existing local data is enabled by these values alone.
INTERVIEW_AUTH_ISSUER=
INTERVIEW_AUTH_AUDIENCE=
INTERVIEW_AUTH_JWKS_URL=
INTERVIEW_AUTH_ALGORITHMS=
