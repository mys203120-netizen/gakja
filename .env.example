# Copy to root .env.local. The launcher, DB scripts and Next use the same loader.
# Precedence: process environment > root .env.local > root .env.
# Leave external-service credentials empty until you configure the service.

# Required DB connection. Use your local DB password or Supabase direct/session pooler.
DATABASE_URL=
DATABASE_SSL=false
AUTH_MODE=local
ALLOW_LOCAL_AUTH=true
TEST_ACCOUNT_PASSWORD=
LOCAL_PG_PORT=54329
LOCAL_PG_PASSWORD=

# Leave PORT empty to select an available local port (3000, then 3100-3119).
# The launcher also reuses the last running app port from .local/server.json.
PORT=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server redirect/callback origin, read at runtime even after next build.
# Production: set APP_URL=https://your-service.example to the registered OAuth URL.
# Leave empty locally; the launcher's selected NEXT_PUBLIC_APP_URL is the fallback.
APP_URL=

# Supabase mode requires the project's actual values and DATABASE_SSL=true.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=student-media

# Google/Kakao social signup. Server-only; never use NEXT_PUBLIC_ for secrets.
# Local auth: create OAuth clients for the actual APP URL, then fill these values.
# Google redirect: <APP_URL or NEXT_PUBLIC_APP_URL>/api/auth/callback/google
# Kakao redirect: <APP_URL or NEXT_PUBLIC_APP_URL>/api/auth/callback/kakao
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Optional consent scopes; account_email requires Kakao console permission.
KAKAO_SCOPE=
# Supabase mode: enable providers in its console, then mark them enabled here.
# Provider redirect: https://<project-ref>.supabase.co/auth/v1/callback
# Supabase redirect allowlist: <APP_URL or NEXT_PUBLIC_APP_URL>/auth/callback**
SUPABASE_GOOGLE_ENABLED=false
SUPABASE_KAKAO_ENABLED=false

# Text AI: server only. API keys must never have a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MODEL_CHAT=gpt-5.6-terra
OPENAI_MODEL_INTERVIEW=gpt-5.6-terra
AI_DAILY_REQUEST_LIMIT=60

# STT and display formatting share OPENAI_API_KEY. TTS is configured separately.
# No automatic fallback between providers or models.
STT_PROVIDER=openai
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
TRANSCRIPT_CLEANUP_ENABLED=true
OPENAI_TRANSCRIPT_CLEANUP_MODEL=gpt-6-luna
# Milliseconds: default 25000; supported range 5000-30000.
OPENAI_TRANSCRIPT_CLEANUP_TIMEOUT_MS=25000

# Live TTS uses the existing OpenAI key (2026-10-17 user choice). STT is separate.
SPEECH_PROVIDER=openai
GOOGLE_CLOUD_PROJECT=
# Absolute path to a private service-account JSON, preferably under .local/.
GOOGLE_APPLICATION_CREDENTIALS=
# Optional temporary token when not using the service-account file above.
GOOGLE_SPEECH_ACCESS_TOKEN=
GOOGLE_STT_LOCATION=us
GOOGLE_STT_MODEL=chirp_3
GOOGLE_STT_LANGUAGE_CODE=ko-KR
GOOGLE_TTS_LANGUAGE_CODE=ko-KR
GOOGLE_TTS_VOICE_FEMALE=ko-KR-Chirp3-HD-Aoede
GOOGLE_TTS_VOICE_MALE=ko-KR-Chirp3-HD-Charon
# Reserved for a separately deployed streaming speech relay; setting it alone is insufficient.
GOOGLE_SPEECH_RELAY_URL=

# Used for TTS only when SPEECH_PROVIDER=openai is explicitly selected.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
